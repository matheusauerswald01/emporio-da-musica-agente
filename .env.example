# Copie este arquivo para .env e preencha a chave. O .env nunca vai para o Git.
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env

# Chave da API do Gemini, gerada em https://aistudio.google.com/apikey
# Atenção (LGPD): no free tier, o Google pode usar o conteúdo enviado para
# melhorar seus produtos. Com dados reais de clientes, use uma chave do tier pago.
GOOGLE_API_KEY=

# Modelo de chat (precisa suportar function calling)
GEMINI_MODEL=gemini-3.8-flash

# Modelos reserva, em ordem e separados por vírgula: respondem quando o de chat está
# indisponível (cota esgotada, sobrecarga, rede). Cada um precisa ter a própria cota no
# Google: o gemini-3.7-flash e o gemini-3.5-flash gastam a cota do 3.8 e do 3.6.
# Deixe vazio para desligar as reservas.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Modelo de embeddings usado na busca do manual de políticas (RAG)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
